<?xml version="1.0"?>
<!--
  OpenArm v2.0 bimanual robot for the Gazebo Harmonic cup-sorting simulation.

  This wraps the upstream OpenArm description (openarm_description, unmodified) and adds:
    * the Gazebo robot preset (presets/default_bimanual_gazebo.yaml in THIS package), which
      selects gz_ros2_control/GazeboSimSystem hardware and the v2.0 joint4 limit override
    * the gz_ros2_control Gazebo plugin (controllers from `controllers_file`)
    * the simulated RGB-D sensor and its ROS TF frames (link + optical frame)

  Arguments:
    controllers_file   ros2_control controller YAML loaded by gz_ros2_control inside Gazebo
                       (default: config/gazebo_controllers.yaml of this package)
    robot_preset_file  OpenArm robot preset YAML
                       (default: presets/default_bimanual_gazebo.yaml of this package)

  Expand it by hand (after sourcing the workspace):
    xacro $(ros2 pkg prefix openarm_sorting_description)/share/openarm_sorting_description/urdf/openarm_v20_gazebo.urdf.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Provides openarm_assemble_robot, openarm_ros2_control and openarm_require. -->
  <xacro:include filename="$(find openarm_description)/assets/common/robot.xacro" />

  <xacro:arg name="robot_preset_file"
             default="$(find openarm_sorting_description)/presets/default_bimanual_gazebo.yaml" />
  <xacro:arg name="controllers_file"
             default="$(find openarm_sorting_description)/config/gazebo_controllers.yaml" />
  <xacro:arg name="emit_grasp_frame" default="false" />
  <xacro:arg name="ros2_control" default="true" />
  <xacro:arg name="fake_sensor_commands" default="false" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="left_can_interface" default="" />
  <xacro:arg name="right_can_interface" default="" />
  <xacro:arg name="can_fd" default="" />
  <!-- Gazebo-only grasp assist (coffee scenario): name of the model the LEFT hand may weld to
       through gz::sim::systems::DetachableJoint ("" = no plugin, the default). See
       visual_manipulation_gazebo/grasp_assist.py. -->
  <xacro:arg name="grasp_assist_child_model" default="" />

  <!-- Same body as the upstream `openarm_robot` macro (openarm_description
       assets/common/robot.xacro @ 8dbfcc9). The ONLY difference is that the preset is
       loaded from an explicit file path instead of $(find openarm_description)/presets,
       so the Gazebo preset can live in this package instead of inside the upstream clone. -->
  <xacro:macro name="openarm_sorting_robot"
    params="preset_file emit_grasp_frame:=false ros2_control:=true use_fake_hardware:=true fake_sensor_commands:=false can_interface:='' left_can_interface:='' right_can_interface:='' can_fd:='' out_name:=component_descriptions">

    <xacro:property name="robot_preset_cfg" value="${xacro.load_yaml(preset_file)}" lazy_eval="false" />

    <xacro:openarm_require
      condition="${python.isinstance(robot_preset_cfg['robot']['name'], str) and bool(robot_preset_cfg['robot']['name'].strip())}"
      message="robot.name must be a non-empty string." />
    <xacro:property name="robot_name" value="${robot_preset_cfg['robot']['name']}" scope="parent" lazy_eval="false" />

    <xacro:openarm_assemble_robot out_name="component_descriptions"
      component_api="${dict(describe='openarm_describe_auto_component', emit='openarm_emit_auto_component')}"
      robot_preset="${robot_preset_cfg}"
      emit_grasp_frame="${emit_grasp_frame}" />

    <xacro:if value="${ros2_control}">
      <xacro:property name="hardware_defaults" value="${dict(
        openarm_hardware_interface=dict(hardware_plugin='openarm_hardware/OpenArmHW', can_interface='can0', can_fd=True),
        openarm_left_hardware_interface=dict(hardware_plugin='openarm_hardware/OpenArmHW', can_interface='can1', can_fd=True),
        openarm_right_hardware_interface=dict(hardware_plugin='openarm_hardware/OpenArmHW', can_interface='can0', can_fd=True))}" />
      <xacro:openarm_require condition="${str(can_fd).lower() in ['', 'true', 'false', '1', '0']}"
        message="can_fd must be true, false, 1, 0, or empty." />
      <xacro:property name="fd_override" value="${dict(can_fd=str(can_fd).lower() in ['true', '1']) if can_fd != '' else dict()}" />
      <xacro:property name="single_override" value="${dict(can_interface=can_interface) if can_interface else dict()}" />
      <xacro:property name="left_override" value="${dict(can_interface=left_can_interface) if left_can_interface else dict()}" />
      <xacro:property name="right_override" value="${dict(can_interface=right_can_interface) if right_can_interface else dict()}" />
      <xacro:property name="hardware_overrides" value="${dict(
        openarm_hardware_interface=dict(fd_override, **single_override),
        openarm_left_hardware_interface=dict(fd_override, **left_override),
        openarm_right_hardware_interface=dict(fd_override, **right_override))}" />
      <xacro:openarm_ros2_control robot_preset="${robot_preset_cfg}"
        component_descriptions="${component_descriptions}"
        use_fake_hardware="${use_fake_hardware}" fake_sensor_commands="${fake_sensor_commands}"
        hardware_defaults="${hardware_defaults}" hardware_overrides="${hardware_overrides}" />
    </xacro:if>

    <xacro:property name="${out_name}" value="${component_descriptions}" scope="parent" lazy_eval="false" />
  </xacro:macro>

  <!-- Gripper note. openarm_*_finger_joint2 is a URDF mimic of finger_joint1 and is
       deliberately NOT part of ros2_control (the OpenArm macro rejects that). In Gazebo
       the mimic is therefore enforced by the physics engine, which is why the cup-sorting
       world uses bullet-featherstone (DART cannot create mimic constraints, so the second
       finger never moved). Adding finger_joint2 to ros2_control as well was tested and
       makes gz_ros2_control fight the physics constraint (fingers stuck) - do not do that. -->
  <xacro:openarm_sorting_robot
    preset_file="$(arg robot_preset_file)"
    emit_grasp_frame="$(arg emit_grasp_frame)"
    ros2_control="$(arg ros2_control)"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"
    left_can_interface="$(arg left_can_interface)"
    right_can_interface="$(arg right_can_interface)"
    can_fd="$(arg can_fd)" />

  <xacro:attribute name="name" value="${robot_name}" />

  <!-- Gazebo ROS 2 Control plugin. Its controller manager (/controller_manager) is the only
       one in the system; no ros2_control_node is started. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

  <!-- Optional Gazebo grasp assist: a fixed joint between the left hand and <child_model>,
       created / removed on request (gz topics /grasp_assist/attach, /grasp_assist/detach).
       The plugin attaches when it starts; grasp_assist.py detaches it immediately and then only
       attaches while the fingers are stalled closed on the handle. Simulation only - it stands
       in for the friction a real rubber-padded pinch grip provides, which the bullet-featherstone
       box contacts reproduce poorly (measured creep of the cantilevered portafilter). -->
  <xacro:property name="grasp_assist_model" value="$(arg grasp_assist_child_model)" />
  <xacro:if value="${grasp_assist_model != ''}">
    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>openarm_left_ee_base_link</parent_link>
        <child_model>${grasp_assist_model}</child_model>
        <child_link>link</child_link>
        <attach_topic>/grasp_assist/attach</attach_topic>
        <detach_topic>/grasp_assist/detach</detach_topic>
        <output_topic>/grasp_assist/state</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- TF frame of the simulated RGB-D sensor (published by robot_state_publisher).
       It sits 3 cm in front of openarm_body_zed_camera_center along the camera
       forward (x) axis, just outside the ZED Mini housing and zed_mount shell
       (their front faces are at x = +0.0218 and +0.0224 m in that frame).
       With the sensor at the housing center, every pixel hit the housing closer
       than the near clip, so RGB was a flat background color and depth was all -inf.
       Axes follow the Gazebo sensor convention (x forward, y left, z up), and the
       /openarm_zed/points cloud is expressed in this convention. -->
  <link name="openarm_zed_sim_camera_link" />
  <joint name="openarm_zed_sim_camera_joint" type="fixed">
    <parent link="openarm_body_zed_camera_center" />
    <child link="openarm_zed_sim_camera_link" />
    <origin xyz="0.03 0 0" rpy="0 0 0" />
  </joint>

  <!-- ROS optical frame of the same sensor (z forward, x right, y down; REP 103).
       Pixel back-projection (u, v, depth) with the CameraInfo K matrix yields
       coordinates in THIS frame. Gazebo still stamps the messages with
       openarm_zed_sim_camera_link, and the point cloud data is x-forward. -->
  <link name="openarm_zed_sim_camera_optical_frame" />
  <joint name="openarm_zed_sim_camera_optical_joint" type="fixed">
    <parent link="openarm_zed_sim_camera_link" />
    <child link="openarm_zed_sim_camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>

  <!-- Simulated RGB-D sensor, attached to openarm_body_link0 (the camera links
       are fixed-joint-lumped by the URDF->SDF conversion). -->
  <gazebo reference="openarm_body_link0">
    <sensor name="openarm_zed_rgbd" type="rgbd_camera">

      <!-- Pose relative to openarm_body_link0. Must equal the TF pose of
           openarm_zed_sim_camera_link, which is the camera center (0.0686446
           0.000966585 0.8140378, pitch 1.082104) plus 0.03 m along its x axis. -->
      <pose>0.0827288 0.000966585 0.7875494 0 1.082104 0</pose>

      <!-- frame_id used in image, depth, camera_info and point cloud headers -->
      <gz_frame_id>openarm_zed_sim_camera_link</gz_frame_id>

      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>

      <topic>/openarm_zed</topic>

      <camera>
        <horizontal_fov>1.5708</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
        </image>

        <clip>
          <near>0.10</near>
          <far>5.0</far>
        </clip>
      </camera>

    </sensor>
  </gazebo>

</robot>
