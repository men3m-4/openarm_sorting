<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_sorting_vision</name>
  <version>0.2.0</version>
  <description>
    RGB-D perception for the OpenArm cup-sorting simulation: OpenCV HSV colour segmentation
    of the red and blue cubes, depth back-projection and TF transformation to 3D cube poses
    in the world frame, plus a ground-truth detection validator (test tool).
  </description>
  <maintainer email="muhammad.abdelmoniem4@gmail.com">men3m</maintainer>
  <license>Apache-2.0</license>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- ground_truth.py (test tools only): Gazebo Harmonic Python bindings gz.transport13 / gz.msgs10 -->
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
