<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>visual_manipulation_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic integration layer of the visual-manipulation framework (SIMULATION ONLY):
    ground-truth access through Gazebo Transport, the check_portafilter validation tool and the
    optional DetachableJoint grasp assist. No core package depends on it.
  </description>
  <maintainer email="muhammad.abdelmoniem4@gmail.com">men3m</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>
  <exec_depend>visual_manipulation_core</exec_depend>
  <exec_depend>visual_manipulation_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
