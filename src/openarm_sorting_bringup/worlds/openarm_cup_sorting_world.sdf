<?xml version="1.0" ?>
<!--
  OpenArm 2.0 cup-sorting world.

  Coordinates are in the `world` frame, which coincides with the OpenArm root
  (openarm_body_link0 is attached to `world` at the origin, +x = robot forward,
  +y = robot left, where the LEFT arm is mounted).

  Layout (must match openarm_sorting_manipulation/config/cup_sorting_scene.yaml):
    table top surface z = 0.30, table spans x 0.12..0.62, y -0.35..0.45
    red cube  centre (0.30, 0.04, 0.32)   4 cm
    blue cube centre (0.30, 0.16, 0.32)   4 cm
    coffee cup bottom centre (0.36, 0.32, 0.30), handle pointing +y
  The positions were chosen from an IK study of the LEFT arm: the 60 deg pitched grasp has a
  continuous IK solution from grasp to lift height with >= 0.26 rad joint-limit margin at
  each cube and at the cup release points (see docs/architecture/SYSTEM_ARCHITECTURE.md).

  Models (model://...) are resolved via GZ_SIM_RESOURCE_PATH, which simulation.launch.py sets
  to the installed share/openarm_sorting_bringup/models directory.
-->
<sdf version="1.9">
  <world name="openarm_cup_sorting">

    <!-- 2 ms step: finer than the 4 ms of default.sdf, for steadier finger/cube contacts -->
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- bullet-featherstone instead of the default DART engine: DART in gz-physics 7 cannot
         create mimic constraints ("the chosen physics engine does not support mimic
         constraints"), so the second gripper finger (openarm_*_finger_joint2, a URDF mimic
         of finger_joint1) never moved and grasping was impossible. bullet-featherstone
         implements SetMimicConstraintFeature (verified - both fingers move symmetrically). -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <!-- Same rendering setup as the validated camera configuration (default.sdf) -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.72 0.75 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="false">
      <plugin name="3D View" filename="GzScene3D">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0.80 0.82 0.85</background_color>
        <camera_pose>1.35 0.9 1.15 0 0.45 -2.55</camera_pose>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>0</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
    </gui>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.25 0.35 -0.9</direction>
      <diffuse>0.85 0.85 0.83 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
    </light>
    <!-- soft fill light from the front so object tops are evenly lit for the camera -->
    <light name="fill" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.35</intensity>
      <direction>-0.6 -0.2 -0.75</direction>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.56 1</ambient>
            <diffuse>0.62 0.62 0.63 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://cup_sorting_table</uri>
      <name>cup_sorting_table</name>
      <pose>0.37 0.05 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://coffee_cup</uri>
      <name>coffee_cup</name>
      <!-- yaw +90 deg: handle (model +x) points to world +y, away from the arm's path -->
      <pose>0.36 0.32 0.30 0 0 1.5707963</pose>
    </include>

    <include>
      <uri>model://red_cube</uri>
      <name>red_cube</name>
      <pose>0.30 0.04 0.32 0 0 0</pose>
    </include>

    <include>
      <uri>model://blue_cube</uri>
      <name>blue_cube</name>
      <pose>0.30 0.16 0.32 0 0 0</pose>
    </include>

  </world>
</sdf>
