<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cup_sorting_table">
    <static>true</static>
    <!-- Model origin = floor point below the table centre. Top surface at z = 0.3 m.
         Light birch laminate top (low saturation, so it never falls in the red/blue HSV ranges),
         dark steel legs. -->
    <link name="table_link">
      <collision name="top_collision">
        <pose>0 0 0.2875 0 0 0</pose>
        <geometry><box><size>0.5 0.8 0.025</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
