<?xml version="1.0"?>
<sdf version="1.9">
  <model name="red_cube">
    <!-- 4.0 cm cube, 50 g. Model origin = cube centre.
         Size chosen for the OpenArm pinch gripper: the fingertip pads (20 mm tall) close
         to a 40 mm gap at about 0.22 rad; with the 60 deg pitched grasp the pads grip the
         upper ~14 mm of the cube while the fingers stay 4 mm above the table. -->
    <link name="cube_link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1.3333e-05</ixx><iyy>1.3333e-05</iyy><izz>1.3333e-05</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>1e5</kp><kd>10</kd><max_vel>0.1</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <material>
          <ambient>0.85 0.06 0.05 1</ambient>
          <diffuse>0.85 0.06 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.55</roughness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
