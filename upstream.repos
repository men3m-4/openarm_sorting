# Upstream OpenArm repositories, pinned to the exact commits this project was built and
# validated with. They are used UNMODIFIED.
#   mkdir -p src/upstream && vcs import src/upstream < upstream.repos
repositories:
  openarm_ros2:
    type: git
    url: https://github.com/enactic/openarm_ros2.git
    version: 8f23aeabb372c256f7807b9a74d48e035fc68386
  openarm_description:
    type: git
    url: https://github.com/enactic/openarm_description.git
    version: 8dbfcc93419f26c41731c3c98c2a46a82e718e65
  openarm_can:
    type: git
    url: https://github.com/enactic/openarm_can.git
    version: 26b266ae90c36ead9f84dcba2d747c4762a94c18
